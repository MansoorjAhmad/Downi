# Dependencies
node_modules/

# Local Android SDK and Caches
.android-home/
.gradle-cache/
.npm-cache/
android-sdk/
test_out/
# The verification toolkit is TRACKED (2026-09-28): the scripts that made every v3.3 gate
# reproducible - the Lottie generator behind the committed art, the state/motion/touch gates,
# safe_shot.ps1 (the UTF-16 screenshot rule) and core_web_anim.py (the foreground-cost instrument).
# Everything vendored around them stays out: tools/jdk and tools/python311 are whole toolchain
# distributions, and the installers/packages are caught by the *.exe / *.zip rules below.
tools/*
!tools/*.py
!tools/*.ps1
!tools/*.cmd
!tools/*.md
!tools/*.json
# tools/harness holds the on-device measurement harnesses (scripts + README), the same kind of content
# the rules above keep: a nested directory needs its own re-include, because `tools/*` excludes the
# directory itself and git never descends into an excluded directory to apply `!tools/*.ps1`.
!tools/harness/
!tools/harness/*.ps1
!tools/harness/*.md
__pycache__/
*.pyc
*.pyo

# Android Build Outputs & Local configs
android/.gradle/
android/build/
android/app/build/
android/capacitor-cordova-android-plugins/build/
android/local.properties
android/.idea/
*.iml
.gradle/
build/

