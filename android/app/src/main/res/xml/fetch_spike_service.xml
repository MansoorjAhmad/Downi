<?xml version="1.0" encoding="utf-8"?>
<!-- V3.2 Phase 0 detectability spike: reads IG/TikTok trees on this device only.
     canTakeScreenshot is an API 34+ platform attribute: required for the diagnostic
     takeScreenshot() calls on API 34+, ignored by older OS versions. Removing it was
     one wrong hypothesis during the 2026-09-24 device hunt — the real blocker was the
     service's intent action in AndroidManifest.xml (see the comment there). -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewScrolled"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="250"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:canTakeScreenshot="true"
    android:description="@string/fetch_spike_desc" />
