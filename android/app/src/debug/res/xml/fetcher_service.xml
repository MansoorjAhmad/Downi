<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG-only override of the release fetcher_service.xml: re-adds the API 34+
     screenshot capability so the bench instruments (takeScreenshot diagnostics,
     capped at 6/session) keep working in debug builds. Release never sees this
     file — see the comment in src/main/res/xml/fetcher_service.xml. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewScrolled"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="250"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:canTakeScreenshot="true"
    android:canPerformGestures="true"
    android:description="@string/fetcher_desc" />
